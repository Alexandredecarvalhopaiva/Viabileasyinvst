# Python 3.12+. Copie para .env e reinicie python -m backend.
APP_URL=http://127.0.0.1:4173
PORT=4173
HOST=127.0.0.1
APP_ENV=development

# Vazio usa .data/accounts.sqlite e mantém as contas do backend anterior.
# Em produção: conexão PostgreSQL do Neon, com sslmode=require.
DATABASE_URL=

# Google Cloud > Google Auth Platform > Clientes > Aplicativo da Web.
# URI de redirecionamento autorizado:
# http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use uma API HTTPS de e-mail no Render gratuito, que bloqueia SMTP.
BREVO_API_KEY=
# Configure uma única API: Brevo (prioritária) ou Resend (alternativa).
RESEND_API_KEY=
# MAIL_FROM precisa ser de um remetente validado no provedor de e-mail.
# Sem domínio próprio, o modo de teste do Resend atende apenas o e-mail da conta.
# SMTP continua disponível para instalações que permitem essas portas.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ViabilEasy <contato@seu-dominio.com.br>

# APP_ENV=production
# DATA_DIR=/caminho/persistente/viabileasy
# Produção exige HTTPS, PostgreSQL e um provedor de e-mail.
# Só configure '*' se o servidor estiver acessível exclusivamente por proxy confiável.
# FORWARDED_ALLOW_IPS=127.0.0.1
