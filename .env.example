# Node.js 24+. Copie para .env e reinicie npm run prototype.
APP_URL=http://127.0.0.1:4173
PORT=4173
HOST=127.0.0.1

# Google Cloud > Google Auth Platform > Clientes > Aplicativo da Web.
# URI de redirecionamento autorizado:
# http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sem SMTP no ambiente local, as mensagens são gravadas em .data/mail/.
# Em produção, SMTP e APP_URL HTTPS são obrigatórios.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ViabilEasy <contato@seu-dominio.com.br>

# NODE_ENV=production
# DATA_DIR=/caminho/persistente/viabileasy
