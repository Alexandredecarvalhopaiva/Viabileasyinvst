{
  "name": "urba-prototipo",
  "version": "0.15.0",
  "private": true,
  "description": "Protótipo ViabilEasy: potencial construtivo do terreno por tipologia",
  "scripts": {
    "prototype": "node scripts/python.mjs -m backend",
    "verify:geometry": "node verify-geometry.cjs",
    "test:accounts": "node scripts/python.mjs -m pytest -q tests/python/test_accounts.py tests/python/test_migration.py",
    "test:approvals": "node scripts/python.mjs -m pytest -q tests/python/test_accounts.py -k \"approval or bootstrap or signup\"",
    "test:documents": "node scripts/python.mjs -m pytest -q tests/python/test_studies_documents.py",
    "test:usage": "node scripts/python.mjs -m pytest -q tests/python/test_studies_documents.py",
    "account:role": "node scripts/python.mjs -m backend.cli set-role",
    "test:setbacks": "node --test test/setbacks.test.cjs",
    "test:capacity": "node --test test/building-capacity.test.cjs",
    "vendor:three": "node scripts/vendor-three.mjs",
    "test:experience": "node --test test/experience3d.test.mjs test/experience-comparison.test.mjs",
    "build:public": "node scripts/render-public.mjs",
    "preprototype": "node scripts/render-public.mjs",
    "test:backend": "node scripts/python.mjs -m pytest -q",
    "test:frontend": "node --test test/*.test.cjs test/*.test.mjs",
    "test": "npm run test:backend && npm run test:frontend && npm run verify:geometry",
    "audit:ui": "node scripts/python.mjs -m backend.preview",
    "test:supabase": "node --test test/pages-supabase.test.mjs && node scripts/python.mjs -m pytest -q tests/supabase/test_database.py"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
